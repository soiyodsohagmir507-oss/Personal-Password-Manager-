rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /userAccounts/{accountId} {
      allow read, write: if true;
    }
    match /userVaults/{vaultId} {
      allow read, write: if true;
    }
    match /users/{userId} {
      allow read, write: if true;

      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }
  }
}
